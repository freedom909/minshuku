{
  "name": "subgraph-auths-tests",
  "version": "1.0.0",
  "description": "Test suite for subgraph authentication system",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js unit.test.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js integration.test.js",
    "test:performance": "node --experimental-vm-modules node_modules/jest/bin/jest.js performance.test.js",
    "test:security": "node --experimental-vm-modules node_modules/jest/bin/jest.js security.test.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "start": "nodemon index.js"
  },
  "dependencies": {
    "@apollo/server": "^4.7.5",
    "google-auth-library": "^8.9.0",
    "jsonwebtoken": "^9.0.0",
    "node-fetch": "^2.6.12",
    "nodemon": "^3.1.10"
  },
  "devDependencies": {
    "@babel/core": "^7.22.5",
    "@babel/preset-env": "^7.22.5",
    "@types/jest": "^29.5.2",
    "babel-jest": "^29.6.0",
    "jest": "^29.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.{js,jsx}",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
